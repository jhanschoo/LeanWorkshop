import Mathlib.Tactic.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Positivity
import Mathlib.Basic.Real.Basic
import Mathlib.Data.Nat.Basic

/-!
# Part 4.3: Diagnosing and Recovering from Common Errors

Whether written by a human beginner or generated by an LLM, first attempts in Lean 4 fail in
**four highly predictable ways**. Reading the exact compiler error tells you how to fix it in
seconds.

---

## 1. Failure Mode 1: Hallucinated Lemma Names (`unknown identifier`)

**Symptom:**
`error: unknown identifier 'Nat.add_comm_right'` or `'Real.square_nonneg'`

**Why it happens:** Guessing plausible-sounding lemma names from memory instead of checking Mathlib
nomenclature (`_right_comm`, `sq_nonneg`) or using automation.

**Recovery:**
- Replace guessed lemmas with `exact?`, `ring`, `omega`, or `positivity`.
-/

namespace LeanWorkshop.Part4

/-- Recovered from hallucinated `Real.square_nonneg` using `sq_nonneg` or `positivity`. -/
example (x : ℝ) : 0 ≤ x ^ 2 + 1 := by
  -- Broken LLM attempt: exact add_pos_of_nonneg_of_pos (Real.square_nonneg x) zero_lt_one
  positivity

/-!
---

## 2. Failure Mode 2: Lean 3 Legacy Syntax

Older tutorials and LLM weights frequently emit Lean 3 syntax. Here is the quick translation table:

| Lean 3 (Broken in Lean 4) | Lean 4 (Valid) |
| :--- | :--- |
| `begin ... end` | `by ...` (indentation-based) |
| Trailing commas `,` after tactics | Newlines (or `;` on one line) |
| `λ x, x + 1` | `fun x ↦ x + 1` |
| `rw h` | `rw [h]` (square brackets required) |
| `library_search` / `suggest` | `exact?` / `apply?` |
| `linarith!` / `norm_num1` | `linarith` / `norm_num` |
| `simp_rw h` without brackets | `simp_rw [h]` |

---

## 3. Failure Mode 3: Rewrite Direction & Binder Mismatches

**Symptom:**
`error: tactic 'rewrite' failed, did not find instance of the pattern in the target expression`

**Why it happens:**
- Given `h : a = b`, `rw [h]` searches for `a` and replaces it with `b`. If the goal contains `b`,
  you need the reverse arrow `rw [← h]` (`\l`).
- `rw` cannot rewrite *inside* a `fun x ↦ ...` binder directly; use `funext x` first or `simp only`
  when rewriting under binders.
-/

/-- Using `rw [← h]` when the hypothesis has the opposite orientation. -/
example {x y : ℝ} (h : x + 1 = y) : 2 * y = 2 * x + 2 := by
  -- Broken attempt: `rw [h]` fails because `x + 1` is not in `2 * y = 2 * x + 2`!
  rw [← h]
  ring

/-!
---

## 4. Failure Mode 4: Tactic Scope Limits (`linarith` and `ring`)

**Symptom:**
`linarith failed to find contradiction` on a nonlinear goal, OR `ring` fails when a hypothesis
relates the variables.

**Why it happens:**
1. **`ring` ignores local hypotheses** (`h : a = b + 1`): always `rw [h]` (or `subst`) *before*
   calling `ring`.
2. **`linarith` treats nonlinear terms (like `x ^ 2` or `a * b`) as opaque atoms:** it does not
   automatically know `0 ≤ x ^ 2` unless you state `have hx2 : 0 ≤ x ^ 2 := sq_nonneg x` first!
-/

/-- Teaching `linarith` a nonlinear fact (`0 ≤ x ^ 2`) via an auxiliary `have`. -/
example {x y : ℝ} (h : y ≤ 10) : y ≤ x ^ 2 + 10 := by
  -- Broken attempt: `linarith` alone fails because it treats `x ^ 2` as an arbitrary symbol!
  have hsq : 0 ≤ x ^ 2 := sq_nonneg x
  linarith

/-!
---

## 5. Exercises

Each exercise below shows a commented-out broken LLM attempt right above `sorry`. Fix each proof!
(Reference solutions are in `LeanWorkshop/Solutions/Part4_Autoformalization/S3_ErrorRecovery.lean`.)
-/

/-- **Exercise 1:** Fix the hallucinated lemma name. -/
theorem ex1_fix_hallucinated_lemma (a b c : ℕ) : a + b + c = a + c + b := by
  -- Broken attempt: exact Nat.add_comm_right a b c
  sorry

/-- **Exercise 2:** Fix the rewrite direction error. -/
theorem ex2_fix_rw_direction {x y : ℝ} (h : x + 3 = y) : 2 * y = 2 * x + 6 := by
  -- Broken attempt: rw [h]; ring
  sorry

/-- **Exercise 3:** Fix `linarith` on a goal containing `x ^ 2` (or note why `h` suffices). -/
theorem ex3_fix_nonlinear_linarith {x y : ℝ} (h : x ≤ y) :
    x + x ^ 2 ≤ y + x ^ 2 + 1 := by
  sorry

/-- **Exercise 4:** Fix `ring` failing to see hypothesis `h : a = 2 * b + 1`. -/
theorem ex4_fix_ring_with_hyp {a b : ℝ} (h : a = 2 * b + 1) :
    a ^ 2 - 4 * b ^ 2 = 4 * b + 1 := by
  -- Broken attempt: ring
  sorry

end LeanWorkshop.Part4
